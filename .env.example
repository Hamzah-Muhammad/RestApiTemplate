# Copy to .env and edit. Never commit the real .env.

# SQLite by default - zero setup for local dev.
# For Postgres (matches docker-compose): postgresql://postgres:postgres@localhost:5432/restapi_user_management_example
DATABASE_URL=sqlite:///./app.db

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

ACCESS_TOKEN_EXPIRE_MINUTES=60
